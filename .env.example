# Ambient configuration. Copy to `.env` and fill in. Loaded by pydantic-settings
# (ambient/config.py); env vars are case-insensitive.
#
# ────────────────────────────────────────────────────────────────────────────
# QUICKSTART (CLI — no server, no DB, no S3): the only things you truly need are
# an OpenAI-compatible LLM endpoint + key. With OpenRouter you can set just the
# one key below and the CLI fills in the base URL for you.
# ────────────────────────────────────────────────────────────────────────────

# Easiest: one OpenRouter key powers both the agent loop and the vision/tool
# calls, and the CLI defaults LLM_BASE_URL to OpenRouter automatically.
OPENROUTER_API_KEY=sk-or-...

# …or point at any OpenAI-compatible chat-completions endpoint explicitly:
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_API_KEY=sk-or-...
# LLM_MODEL=google/gemini-3.1-pro-preview      # vision/tool model
# AGENT_MODEL=google/gemini-3.1-pro-preview    # agent-loop model (can differ)

# ────────────────────────────────────────────────────────────────────────────
# SERVER-ONLY (needed only for `python -m ambient.server`, not the CLI)
# ────────────────────────────────────────────────────────────────────────────
# API_KEY=dev-token                       # bearer/x-api-key clients must send
# DATABASE_URL=postgresql://ambient:ambient@localhost:5432/ambient
# REDIS_URL=redis://localhost:6379/0

# ────────────────────────────────────────────────────────────────────────────
# OPTIONAL BACKENDS (leave unset for local host/ffmpeg + range-proxy media)
# ────────────────────────────────────────────────────────────────────────────
# SANDBOX_BACKEND=host                     # host (ffmpeg + range proxy) | e2b
# E2B_API_KEY=...                          # only if SANDBOX_BACKEND=e2b
# E2B_TEMPLATE=video-analysis-v1-dev

# S3 / R2 — only for the server (hosting sources/clips). The CLI never needs it.
# S3_ENDPOINT=https://<acct>.r2.cloudflarestorage.com
# S3_BUCKET=...
# AWS_ACCESS_KEY_ID=...
# AWS_SECRET_ACCESS_KEY=...

# Video-description embedding (server ingest). Optional.
# EMBEDDING_SERVICE_API_KEY=...

# Bash tool — lets the agent run shell commands (ffmpeg/ffprobe, file inspection).
# Runs inside the e2b sandbox when active, else on the HOST with no OS isolation.
# OFF by default; enable only when you trust the model + prompt.
# ENABLE_BASH_TOOL=true
# BASH_TIMEOUT_SECONDS=120
# BASH_MAX_OUTPUT_BYTES=20000
# BASH_CWD=                                # host working dir; blank -> VIDEO_FOLDER
