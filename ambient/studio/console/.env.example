# Ambient Studio (Next.js console) — environment
# Copy to .env.local for `pnpm dev`. The Studio needs one Postgres database and the
# engine; no Redis.

# --- required -----------------------------------------------------------------

# Sign-in session encryption. Generate: `openssl rand -base64 32`
AUTH_SECRET=****

# The Studio's own database (chats, messages, users). A separate database in the
# same Postgres server the engine uses is fine, e.g.
#   postgresql://ambient:ambient@127.0.0.1:5432/ambient_studio
# Create the schema with `pnpm db:migrate`.
POSTGRES_URL=****

# The Ambient engine (Managed Agents API). The API key stays server-side — the
# browser never sees it.
ENGINE_URL=http://127.0.0.1:8080
ENGINE_API_KEY=****

# --- optional -----------------------------------------------------------------

# Per-user message quota (messages/hour). Unset or 0 = unlimited, which is what
# a self-hosted, bring-your-own-key install wants; set it for a public demo.
# STUDIO_MAX_MESSAGES_PER_HOUR=

# Vercel AI Gateway: only used to write chat titles with an LLM. Without it,
# titles are taken from the first message.
# AI_GATEWAY_API_KEY=****

# Vercel Blob: only backs file attachments in the composer (the paperclip).
# Videos are uploaded to the engine and don't use this.
# BLOB_READ_WRITE_TOKEN=****

# Serve the Studio under a sub-path (e.g. /studio). Leave unset for the root.
# NEXT_PUBLIC_BASE_PATH=
